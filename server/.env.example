# Annadata — Backend Environment Variables Template
# 1. Copy this file to .env (or set these as environment variables in your host)
# 2. Fill in the real values — NEVER commit real values to Git
# 3. For local dev, you can also fill in: src/main/resources/application-dev.properties

# Server
PORT=5454

# Database (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=annadata
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT
# Generate a strong random secret (minimum 64 chars): openssl rand -hex 64
JWT_SECRET=your_super_long_random_jwt_secret_here_minimum_64_chars
JWT_EXPIRY_MS=86400000

# Email / SMTP (Gmail)
# Use a Gmail App Password (not your main password):
# Google Account → Security → 2-Step Verification → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Stripe (International Payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Razorpay (Indian Payments)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Google Gemini AI
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS / Frontend
# Local development
FRONTEND_URL=http://localhost:5173
# Production example (uncomment and set when deploying)
# FRONTEND_URL=https://annadata.vercel.app
