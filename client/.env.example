# Annadata - Frontend Environment Variables Template
# 1. Copy this file to .env
# 2. Fill in the real values
# 3. NEVER commit .env to Git (it's already gitignored)

# Backend API base URL
# Local development:
VITE_API_URL=http://localhost:5454
# Production example (uncomment when deploying):
# VITE_API_URL=https://your-backend.up.railway.app

# Razorpay — PUBLIC Key ID (safe to expose on frontend)
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here

# Stripe — PUBLISHABLE Key (safe to expose on frontend)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
